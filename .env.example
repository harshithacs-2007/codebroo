# Local development (never commit a real .env)
CODEBROO_SECRET=change-me-to-a-long-random-secret
CODEBROO_PORT=8787
CODEBROO_HOST=127.0.0.1
CODEBROO_DATA_DIR=./data
CODEBROO_SANDBOX_DIR=./sandbox
CODEBROO_EXEC_CONCURRENCY=2
CODEBROO_EXEC_TIMEOUT_MS=5000
CODEBROO_MAX_OUTPUT_BYTES=65536
CODEBROO_MAX_SOURCE_BYTES=32768

# Production (set on the host, not in git):
# NODE_ENV=production
# CODEBROO_HOST=0.0.0.0
# CODEBROO_SECRET=<32+ random bytes, hex>
# CODEBROO_PUBLIC_ORIGIN=https://<fly-app>.fly.dev
# CODEBROO_ALLOWED_ORIGINS=https://<fly-app>.fly.dev,https://<vercel-app>.vercel.app
